set -e

OUTPUT_FILE=""
MARKDOWN_FILE=""
SILENT=0
NO_UNKNOWNS=0

help() {
  cat >&2 <<EOF
Lists all installed packages and their licenses.

Usage: $0 [OPTIONS]

Options:
    -o, --output <file>       Write main output (CSV format) to <file>
    -m, --markdown <file>     Additionally write Markdown table to <file>
    -s, --silent              Suppress stdout output
    -n, --no-unknowns         Do not generate unknown-licenses output files
    -h, --help                Show this help and exit

Examples:
    $0
        Show output in pretty table format (stdout)

    $0 -o sbom.csv
        Write CSV output to sbom.csv + print to stdout

    $0 -m sbom.md
        Write Markdown output to sbom.md + print to stdout

    $0 -o sbom.csv -m sbom.md
        Write CSV and Markdown output at the same time

    $0 -o sbom.csv -m sbom.md -n -s
        Write both formats silently, without unknown-licenses output
EOF
}

# Argument parsing
while [[ $# -gt 0 ]]; do
  case "$1" in
    --output|-o)
      OUTPUT_FILE="$2"
      shift 2
      ;;
    --markdown|-m)
      MARKDOWN_FILE="$2"
      shift 2
      ;;
    --silent|-s)
      SILENT=1
      shift
      ;;
    --no-unknowns|-n)
      NO_UNKNOWNS=1
      shift
      ;;
    -h|--help)
      help
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      help
      exit 1
      ;;
  esac
done

SCRIPTLIB=$(dirname "$(readlink -f "$0")")/lib/
test -d "$SCRIPTLIB"

UNKNOWN_CSV="unknown-licenses.csv"
UNKNOWN_MD="unknown-licenses.md"

# Init headers
if [[ -n "$OUTPUT_FILE" ]]; then
  echo "\"St\",\"Name\",\"Version\",\"Arch\",\"Description\",\"Licenses\"" > "$OUTPUT_FILE"
fi

if [[ -n "$MARKDOWN_FILE" ]]; then
  echo "| Status | Name | Version | Arch | Description | License |" > "$MARKDOWN_FILE"
  echo "|--------|------|---------|------|-------------|---------|" >> "$MARKDOWN_FILE"
fi

if [[ $SILENT -eq 0 ]]; then
  printf '%-2s  %-30s %-30s %-6s %-60s %s\n' "St" "Name" "Version" "Arch" "Description" "Licenses"
  printf '%-2s  %-30s %-30s %-6s %-60s %s\n' "--" "----" "-------" "----" "-----------" "--------"
fi

# Init unknown license files if enabled
if [[ $NO_UNKNOWNS -eq 0 ]]; then
  [[ -n "$OUTPUT_FILE" ]] && echo "\"Name\",\"Version\",\"Description\"" > "$UNKNOWN_CSV"
  [[ -n "$MARKDOWN_FILE" ]] && {
    echo "| Name | Version | Description |" > "$UNKNOWN_MD"
    echo "|------|---------|-------------|" >> "$UNKNOWN_MD"
  }
fi

COLUMNS=2000 dpkg -l | grep '^.[iufhwt]' | while read -r pState package pVer pArch pDesc; do
  license=""
  for method in "$SCRIPTLIB"/reader*; do
    [ -f "$method" ] || continue
    license=$("$method" "$package")
    [ $? -eq 0 ] || exit 1
    [ -n "$license" ] || continue
    license=$(echo "$license" | tr '\n' ' ' | sed -r -e 's/ +/ /g' -e 's/^ +//' -e 's/ +$//')
    [ -z "$license" ] || break
  done
  [ -n "$license" ] || license='unknown'

  # Output main result
  [[ -n "$OUTPUT_FILE" ]] && echo "\"$pState\",\"$package\",\"$pVer\",\"$pArch\",\"$pDesc\",\"$license\"" >> "$OUTPUT_FILE"
  [[ -n "$MARKDOWN_FILE" ]] && echo "| \`$pState\` | \`$package\` | \`$pVer\` | \`$pArch\` | $pDesc | $license |" >> "$MARKDOWN_FILE"
  [[ $SILENT -eq 0 ]] && printf '%-2s  %-30s %-30s %-6s %-60s %s\n' "$pState" "${package:0:30}" "${pVer:0:30}" "${pArch:0:6}" "${pDesc:0:60}" "$license"

  # Unknown license reporting
  if [[ "$license" == "unknown" && $NO_UNKNOWNS -eq 0 ]]; then
    [[ -n "$OUTPUT_FILE" ]] && echo "\"$package\",\"$pVer\",\"$pDesc\"" >> "$UNKNOWN_CSV"
    [[ -n "$MARKDOWN_FILE" ]] && echo "| \`$package\` | \`$pVer\` | $pDesc |" >> "$UNKNOWN_MD"
  fi
done

